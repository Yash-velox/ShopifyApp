# Template → copy to .env.local
APP_TYPE=local
# Local: hit FastAPI directly. AWS UAT: use /backend-api (same origin via Node proxy).
VITE_API_BASE_URL=http://127.0.0.1:8080
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_files,read_products,write_files,write_metaobject_definitions,write_metaobjects,write_products
SHOPIFY_APP_URL=http://127.0.0.1:5173
INTERNAL_HANDOFF_SECRET=change-me-handoff
# Absolute URL only (install/uninstall/webhook handoffs + optional /backend-api proxy)
BACKEND_URL=http://127.0.0.1:8080
# Set to 1 to ack Shopify products/update without forwarding to FastAPI.
SKIP_PRODUCTS_UPDATE_BACKEND_FORWARD=0
