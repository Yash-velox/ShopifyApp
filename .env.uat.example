# Template → copy to .env.uat
APP_TYPE=uat
# Browser same-origin API (Node /backend-api proxy → FastAPI on 127.0.0.1:8080).
VITE_API_BASE_URL=/backend-api
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_files,read_products,write_files,write_metaobject_definitions,write_metaobjects,write_products
# UAT public host (nginx HTTPS on EC2)
SHOPIFY_APP_URL=https://aiapp-uat.aonegnd.com
INTERNAL_HANDOFF_SECRET=change-me-handoff-uat
# Absolute URL only - server handoffs + /backend-api proxy target (never /backend-api here)
BACKEND_URL=http://127.0.0.1:8080
# Set to 1 to ack Shopify products/update without forwarding to FastAPI.
SKIP_PRODUCTS_UPDATE_BACKEND_FORWARD=0
